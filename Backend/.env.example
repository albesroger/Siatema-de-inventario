# Conexión a la base de datos (SQLite)
DATABASE_URL="file:./dev.db"

# Secreto para firmar los JWT (mínimo 32 caracteres)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Expiración del token de sesión
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:3001

# Puerto del servidor API
PORT=3000

# (Opcional) Contraseña inicial del usuario admin al ejecutar el seed.
# Si no se define, se genera una aleatoria y se muestra una sola vez.
# SEED_ADMIN_PASSWORD=
