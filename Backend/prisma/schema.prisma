generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model ajuste_inventario {
  id            String   @id @default(uuid())
  negocioId     String   @map("negocio_id")
  usuarioId     String   @map("usuario_id")
  dispositivoId String   @map("dispositivo_id")
  numero        BigInt
  tipo          String
  motivo        String
  observaciones String?
  estado        String   @default("COMPLETADA")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  dispositivo dispositivo        @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction)
  negocio     negocio            @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  usuario     usuario            @relation(fields: [usuarioId], references: [id], onUpdate: NoAction)

  detalles detalle_ajuste[]

  @@unique([negocioId, numero])
  @@index([createdAt])
  @@index([negocioId])
  @@map("ajuste_inventario")
}

model categoria {
  id          String   @id @default(uuid())
  negocioId   String   @map("negocio_id")
  nombre      String
  descripcion String?
  estado      String   @default("ACTIVO")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  negocio   negocio    @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  productos producto[]

  @@unique([negocioId, nombre])
  @@index([negocioId])
  @@map("categoria")
}

model detalle_ajuste {
  id            String   @id @default(uuid())
  ajusteId      String   @map("ajuste_id")
  productoId    String   @map("producto_id")
  cantidad      Decimal
  stockAnterior Decimal  @map("stock_anterior")
  stockNuevo    Decimal  @map("stock_nuevo")
  observaciones String?
  createdAt     DateTime @default(now()) @map("created_at")

  ajuste   ajuste_inventario @relation(fields: [ajusteId], references: [id], onUpdate: NoAction)
  producto producto          @relation(fields: [productoId], references: [id], onUpdate: NoAction)

  @@index([ajusteId])
  @@index([productoId])
  @@map("detalle_ajuste")
}

model detalle_entrada {
  id            String   @id @default(uuid())
  entradaId     String   @map("entrada_id")
  productoId    String   @map("producto_id")
  cantidad      Decimal
  costoUnitario Decimal  @map("costo_unitario")
  descuento     Decimal  @default(0)
  subtotal      Decimal
  createdAt     DateTime @default(now()) @map("created_at")
  entrada       entrada_inventario @relation(fields: [entradaId], references: [id], onUpdate: NoAction)
  producto      producto           @relation(fields: [productoId], references: [id], onUpdate: NoAction)

  @@index([entradaId])
  @@index([productoId])
  @@map("detalle_entrada")
}

model detalle_salida {
  id            String   @id @default(uuid())
  salidaId      String   @map("salida_id")
  productoId    String   @map("producto_id")
  cantidad      Decimal
  observaciones String?
  createdAt     DateTime @default(now()) @map("created_at")
  producto      producto          @relation(fields: [productoId], references: [id], onUpdate: NoAction)
  salida        salida_inventario @relation(fields: [salidaId], references: [id], onUpdate: NoAction)

  @@index([productoId])
  @@index([salidaId])
  @@map("detalle_salida")
}

model detalle_venta {
  id         String   @id @default(uuid())
  ventaId    String   @map("venta_id")
  productoId String   @map("producto_id")

  cantidad       Decimal
  precioUnitario Decimal  @map("precio_unitario")
  descuento      Decimal  @default(0)
  subtotal       Decimal

  createdAt DateTime @default(now()) @map("created_at")

  producto producto @relation(fields: [productoId], references: [id], onUpdate: NoAction)
  venta    venta    @relation(fields: [ventaId], references: [id], onUpdate: NoAction)

  @@index([productoId])
  @@index([ventaId])
}

model dispositivo {
  id                     String     @id @default(uuid())
  negocioId              String     @map("negocio_id")
  nombre                 String
  identificador          String     @unique(map: "uq_dispositivo_identificador")
  tipo                   String
  estado                 String     @default("ACTIVO")
  ultimaSincronizacionAt DateTime?  @map("ultima_sincronizacion_at")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @default(now()) @map("updated_at")
  ajustes                ajuste_inventario[]
  negocio                negocio                    @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  entradas               entrada_inventario[]
  movimientos            movimiento_inventario[]
  operacionesSincronizacion operacion_sincronizacion[]
  salidas                salida_inventario[]
  ventas                 venta[]

  @@index([negocioId])
  @@map("dispositivo")
}

model entrada_inventario {
  id              String   @id @default(uuid())
  negocioId       String   @map("negocio_id")
  proveedorId     String?  @map("proveedor_id")
  usuarioId       String   @map("usuario_id")
  dispositivoId   String   @map("dispositivo_id")
  numero          BigInt
  numeroDocumento String?  @map("numero_documento")
  subtotal        Decimal  @default(0)
  descuento       Decimal  @default(0)
  total           Decimal  @default(0)
  observaciones   String?
  estado          String   @default("COMPLETADA")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")
  detalles        detalle_entrada[]
  dispositivo     dispositivo       @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction)
  negocio         negocio           @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  proveedor       proveedor?        @relation(fields: [proveedorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usuario         usuario           @relation(fields: [usuarioId], references: [id], onUpdate: NoAction)

  @@unique([negocioId, numero])
  @@index([createdAt])
  @@index([negocioId])
  @@index([proveedorId])
  @@map("entrada_inventario")
}

model movimiento_inventario {
  id             String   @id @default(uuid())
  negocioId      String   @map("negocio_id")
  productoId     String   @map("producto_id")
  usuarioId      String   @map("usuario_id")
  dispositivoId  String   @map("dispositivo_id")
  tipo           String
  cantidad       Decimal
  stockAnterior  Decimal  @map("stock_anterior")
  stockPosterior Decimal  @map("stock_posterior")
  referenciaTipo String   @map("referencia_tipo")
  referenciaId   String   @map("referencia_id")
  motivo         String?
  createdAt      DateTime @default(now()) @map("created_at")
  dispositivo    dispositivo                @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction)
  negocio        negocio                    @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  producto       producto                   @relation(fields: [productoId], references: [id], onUpdate: NoAction)
  usuario        usuario                    @relation(fields: [usuarioId], references: [id], onUpdate: NoAction)

  @@index([createdAt])
  @@index([negocioId])
  @@index([productoId])
  @@index([referenciaTipo, referenciaId])
  @@map("movimiento_inventario")
}

model negocio {
  id                       String                     @id @default(uuid())
  nombre                   String
  nombre_comercial         String?
  direccion                String?
  telefono                 String?
  moneda                   String                     @default("CUP")
  estado                   String                     @default("ACTIVO")
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @default(now())
  ajuste_inventario        ajuste_inventario[]
  categoria                categoria[]
  dispositivo              dispositivo[]
  entrada_inventario       entrada_inventario[]
  movimiento_inventario    movimiento_inventario[]
  operacion_sincronizacion operacion_sincronizacion[]
  producto                 producto[]
  proveedor                proveedor[]
  salida_inventario        salida_inventario[]
  usuario                  usuario[]
  venta                    venta[]
}

model operacion_sincronizacion {
  id                String   @id @default(uuid())
  negocio_id        String
  dispositivo_id    String
  secuencia_local   BigInt
  tipo              String
  referencia_id     String
  estado            String   @default("PENDIENTE")
  payload           String
  version           Int      @default(1)
  intentos          Int      @default(0)
  ultimo_intento_at DateTime?
  sincronizado_at   DateTime?
  error_codigo      String?
  error_mensaje     String?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())
  dispositivo       dispositivo           @relation(fields: [dispositivo_id], references: [id], onUpdate: NoAction)
  negocio           negocio               @relation(fields: [negocio_id], references: [id], onUpdate: NoAction)

  @@unique([dispositivo_id, secuencia_local])
  @@index([dispositivo_id, estado])
  @@index([negocio_id, estado])
  @@index([referencia_id])
}

model producto {
  id           String   @id @default(uuid())
  negocioId    String   @map("negocio_id")
  categoriaId  String   @map("categoria_id")
  codigo       String
  codigoBarras String?  @map("codigo_barras")
  nombre       String
  descripcion  String?
  unidadMedida String   @default("UNIDAD") @map("unidad_medida")
  precioCompra Decimal  @default(0) @map("precio_compra")
  precioVenta  Decimal  @default(0) @map("precio_venta")
  stockActual  Decimal  @default(0) @map("stock_actual")
  stockMinimo  Decimal  @default(0) @map("stock_minimo")
  stockMaximo  Decimal? @map("stock_maximo")
  estado       String   @default("ACTIVO")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  detalleAjuste  detalle_ajuste[]
  detalleEntrada detalle_entrada[]
  detalleSalida  detalle_salida[]
  detalleVenta   detalle_venta[]
  movimientos    movimiento_inventario[]

  categoria categoria @relation(fields: [categoriaId], references: [id], onUpdate: NoAction)
  negocio   negocio   @relation(fields: [negocioId], references: [id], onUpdate: NoAction)

  @@unique([negocioId, codigo])
  @@index([categoriaId])
  @@index([codigoBarras])
  @@index([negocioId])
  @@map("producto")
}

model proveedor {
  id             String   @id @default(uuid())
  negocioId      String   @map("negocio_id")
  nombre         String
  telefono       String?
  direccion      String?
  email          String?
  identificacion String?
  observaciones  String?
  estado         String   @default("ACTIVO")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  entradas entrada_inventario[]
  negocio  negocio              @relation(fields: [negocioId], references: [id], onUpdate: NoAction)

  @@index([negocioId])
  @@map("proveedor")
}

model salida_inventario {
  id            String   @id @default(uuid())
  negocioId     String   @map("negocio_id")
  usuarioId     String   @map("usuario_id")
  dispositivoId String   @map("dispositivo_id")
  numero        BigInt
  motivo        String
  observaciones String?
  estado        String   @default("COMPLETADA")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")
  detalles      detalle_salida[]
  dispositivo   dispositivo      @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction)
  negocio       negocio          @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  usuario       usuario          @relation(fields: [usuarioId], references: [id], onUpdate: NoAction)

  @@unique([negocioId, numero])
  @@index([createdAt])
  @@index([negocioId])
  @@map("salida_inventario")
}

model usuario {
  id             String   @id @default(uuid())
  negocioId      String   @map("negocio_id")
  nombre         String
  username       String
  passwordHash   String   @map("password_hash")
  rol            String   @default("ADMINISTRADOR")
  estado         String   @default("ACTIVO")
  ultimoAccesoAt DateTime? @map("ultimo_acceso_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")
  ajustes        ajuste_inventario[]
  entradas       entrada_inventario[]
  movimientos    movimiento_inventario[]
  salidas        salida_inventario[]
  negocio        negocio                 @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  ventas         venta[]

  @@unique([negocioId, username])
  @@index([negocioId])
  @@map("usuario")
}

model venta {
  id            String   @id @default(uuid())
  negocioId     String   @map("negocio_id")
  usuarioId     String   @map("usuario_id")
  dispositivoId String   @map("dispositivo_id")
  numero        BigInt
  subtotal      Decimal  @default(0)
  descuento     Decimal  @default(0)
  impuesto      Decimal  @default(0)
  total         Decimal  @default(0)
  metodoPago    String   @default("EFECTIVO") @map("metodo_pago")
  estado        String   @default("COMPLETADA")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")
  detalleVenta  detalle_venta[]
  dispositivo   dispositivo      @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction)
  negocio       negocio          @relation(fields: [negocioId], references: [id], onUpdate: NoAction)
  usuario       usuario          @relation(fields: [usuarioId], references: [id], onUpdate: NoAction)

  @@unique([negocioId, numero])
  @@index([createdAt])
  @@index([negocioId])
  @@index([usuarioId])
  @@map("venta")
}