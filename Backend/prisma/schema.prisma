generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ajuste_inventario {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId     String           @map("negocio_id") @db.Uuid
  usuarioId     String           @map("usuario_id") @db.Uuid
  dispositivoId String           @map("dispositivo_id") @db.Uuid
  numero        BigInt
  tipo          tipo_ajuste
  motivo        motivo_ajuste
  observaciones String?
  estado        estado_documento @default(COMPLETADA)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime         @default(now()) @map("updated_at") @db.Timestamp(6)

  dispositivo dispositivo @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction, map: "fk_ajuste_dispositivo")
  negocio     negocio     @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_ajuste_negocio")
  usuario     usuario     @relation(fields: [usuarioId], references: [id], onUpdate: NoAction, map: "fk_ajuste_usuario")

  detalles detalle_ajuste[]

  @@unique([negocioId, numero], map: "uq_ajuste_negocio_numero")
  @@index([createdAt], map: "idx_ajuste_fecha")
  @@index([negocioId], map: "idx_ajuste_negocio")
  @@map("ajuste_inventario")
}

model categoria {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId   String         @map("negocio_id") @db.Uuid
  nombre      String         @db.VarChar(100)
  descripcion String?
  estado      estado_general @default(ACTIVO)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamp(6)

  negocio   negocio    @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_categoria_negocio")
  productos producto[]

  @@unique([negocioId, nombre], map: "uq_categoria_negocio_nombre")
  @@index([negocioId], map: "idx_categoria_negocio")
  @@map("categoria")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model detalle_ajuste {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ajusteId      String   @map("ajuste_id") @db.Uuid
  productoId    String   @map("producto_id") @db.Uuid
  cantidad      Decimal  @db.Decimal(14, 3)
  stockAnterior Decimal  @map("stock_anterior") @db.Decimal(14, 3)
  stockNuevo    Decimal  @map("stock_nuevo") @db.Decimal(14, 3)
  observaciones String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  ajuste   ajuste_inventario @relation(fields: [ajusteId], references: [id], onUpdate: NoAction, map: "fk_detalle_ajuste_ajuste")
  producto producto          @relation(fields: [productoId], references: [id], onUpdate: NoAction, map: "fk_detalle_ajuste_producto")

  @@index([ajusteId], map: "idx_detalle_ajuste_ajuste")
  @@index([productoId], map: "idx_detalle_ajuste_producto")
  @@map("detalle_ajuste")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model detalle_entrada {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entradaId     String             @map("entrada_id") @db.Uuid
  productoId    String             @map("producto_id") @db.Uuid
  cantidad      Decimal            @db.Decimal(14, 3)
  costoUnitario Decimal            @map("costo_unitario") @db.Decimal(14, 2)
  descuento     Decimal            @default(0) @db.Decimal(14, 2)
  subtotal      Decimal            @db.Decimal(14, 2)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  entrada       entrada_inventario @relation(fields: [entradaId], references: [id], onUpdate: NoAction, map: "fk_detalle_entrada_entrada")
  producto      producto           @relation(fields: [productoId], references: [id], onUpdate: NoAction, map: "fk_detalle_entrada_producto")

  @@index([entradaId], map: "idx_detalle_entrada_entrada")
  @@index([productoId], map: "idx_detalle_entrada_producto")
  @@map("detalle_entrada")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model detalle_salida {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salidaId      String            @map("salida_id") @db.Uuid
  productoId    String            @map("producto_id") @db.Uuid
  cantidad      Decimal           @db.Decimal(14, 3)
  observaciones String?
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  producto      producto          @relation(fields: [productoId], references: [id], onUpdate: NoAction, map: "fk_detalle_salida_producto")
  salida        salida_inventario @relation(fields: [salidaId], references: [id], onUpdate: NoAction, map: "fk_detalle_salida_salida")

  @@index([productoId], map: "idx_detalle_salida_producto")
  @@index([salidaId], map: "idx_detalle_salida_salida")
  @@map("detalle_salida")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model detalle_venta {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ventaId        String   @map("venta_id") @db.Uuid
  productoId     String   @map("producto_id") @db.Uuid
  cantidad       Decimal  @db.Decimal(14, 3)
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(14, 2)
  descuento      Decimal  @default(0) @db.Decimal(14, 2)
  subtotal       Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  producto producto @relation(fields: [productoId], references: [id], onUpdate: NoAction, map: "fk_detalle_venta_producto")
  venta    venta    @relation(fields: [ventaId], references: [id], onUpdate: NoAction, map: "fk_detalle_venta_venta")

  @@index([productoId], map: "idx_detalle_venta_producto")
  @@index([ventaId], map: "idx_detalle_venta_venta")
  @@map("detalle_venta")
}

model dispositivo {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId                 String                     @map("negocio_id") @db.Uuid
  nombre                    String                     @db.VarChar(100)
  identificador             String                     @unique(map: "uq_dispositivo_identificador") @db.VarChar(255)
  tipo                      tipo_dispositivo
  estado                    estado_dispositivo         @default(ACTIVO)
  ultimaSincronizacionAt    DateTime?                  @map("ultima_sincronizacion_at") @db.Timestamp(6)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime                   @default(now()) @map("updated_at") @db.Timestamp(6)
  ajustes                   ajuste_inventario[]
  negocio                   negocio                    @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_dispositivo_negocio")
  entradas                  entrada_inventario[]
  movimientos               movimiento_inventario[]
  operacionesSincronizacion operacion_sincronizacion[]
  salidas                   salida_inventario[]
  ventas                    venta[]

  @@index([negocioId], map: "idx_dispositivo_negocio")
  @@map("dispositivo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model entrada_inventario {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId       String            @map("negocio_id") @db.Uuid
  proveedorId     String?           @map("proveedor_id") @db.Uuid
  usuarioId       String            @map("usuario_id") @db.Uuid
  dispositivoId   String            @map("dispositivo_id") @db.Uuid
  numero          BigInt
  numeroDocumento String?           @map("numero_documento") @db.VarChar(100)
  subtotal        Decimal           @default(0) @db.Decimal(14, 2)
  descuento       Decimal           @default(0) @db.Decimal(14, 2)
  total           Decimal           @default(0) @db.Decimal(14, 2)
  observaciones   String?
  estado          estado_documento  @default(COMPLETADA)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamp(6)
  detalles        detalle_entrada[]
  dispositivo     dispositivo       @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction, map: "fk_entrada_dispositivo")
  negocio         negocio           @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_entrada_negocio")
  proveedor       proveedor?        @relation(fields: [proveedorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_entrada_proveedor")
  usuario         usuario           @relation(fields: [usuarioId], references: [id], onUpdate: NoAction, map: "fk_entrada_usuario")

  @@unique([negocioId, numero], map: "uq_entrada_negocio_numero")
  @@index([createdAt], map: "idx_entrada_fecha")
  @@index([negocioId], map: "idx_entrada_negocio")
  @@index([proveedorId], map: "idx_entrada_proveedor")
  @@map("entrada_inventario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model movimiento_inventario {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId      String                     @map("negocio_id") @db.Uuid
  productoId     String                     @map("producto_id") @db.Uuid
  usuarioId      String                     @map("usuario_id") @db.Uuid
  dispositivoId  String                     @map("dispositivo_id") @db.Uuid
  tipo           tipo_movimiento
  cantidad       Decimal                    @db.Decimal(14, 3)
  stockAnterior  Decimal                    @map("stock_anterior") @db.Decimal(14, 3)
  stockPosterior Decimal                    @map("stock_posterior") @db.Decimal(14, 3)
  referenciaTipo tipo_referencia_movimiento @map("referencia_tipo")
  referenciaId   String                     @map("referencia_id") @db.Uuid
  motivo         String?                    @db.VarChar(255)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamp(6)
  dispositivo    dispositivo                @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction, map: "fk_movimiento_dispositivo")
  negocio        negocio                    @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_movimiento_negocio")
  producto       producto                   @relation(fields: [productoId], references: [id], onUpdate: NoAction, map: "fk_movimiento_producto")
  usuario        usuario                    @relation(fields: [usuarioId], references: [id], onUpdate: NoAction, map: "fk_movimiento_usuario")

  @@index([createdAt], map: "idx_movimiento_fecha")
  @@index([negocioId], map: "idx_movimiento_negocio")
  @@index([productoId], map: "idx_movimiento_producto")
  @@index([referenciaTipo, referenciaId], map: "idx_movimiento_referencia")
  @@map("movimiento_inventario")
}

model negocio {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                   String                     @db.VarChar(150)
  nombre_comercial         String?                    @db.VarChar(150)
  direccion                String?                    @db.VarChar(255)
  telefono                 String?                    @db.VarChar(50)
  moneda                   String                     @default("CUP") @db.VarChar(10)
  estado                   estado_general             @default(ACTIVO)
  created_at               DateTime                   @default(now()) @db.Timestamp(6)
  updated_at               DateTime                   @default(now()) @db.Timestamp(6)
  ajuste_inventario        ajuste_inventario[]
  categoria                categoria[]
  dispositivo              dispositivo[]
  entrada_inventario       entrada_inventario[]
  movimiento_inventario    movimiento_inventario[]
  operacion_sincronizacion operacion_sincronizacion[]
  producto                 producto[]
  proveedor                proveedor[]
  salida_inventario        salida_inventario[]
  usuario                  usuario[]
  venta                    venta[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model operacion_sincronizacion {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocio_id        String                @db.Uuid
  dispositivo_id    String                @db.Uuid
  secuencia_local   BigInt
  tipo              String                @db.VarChar(30)
  referencia_id     String                @db.Uuid
  estado            estado_sincronizacion @default(PENDIENTE)
  payload           Json
  version           Int                   @default(1)
  intentos          Int                   @default(0)
  ultimo_intento_at DateTime?             @db.Timestamp(6)
  sincronizado_at   DateTime?             @db.Timestamp(6)
  error_codigo      String?               @db.VarChar(100)
  error_mensaje     String?
  created_at        DateTime              @default(now()) @db.Timestamp(6)
  updated_at        DateTime              @default(now()) @db.Timestamp(6)
  dispositivo       dispositivo           @relation(fields: [dispositivo_id], references: [id], onUpdate: NoAction, map: "fk_sync_dispositivo")
  negocio           negocio               @relation(fields: [negocio_id], references: [id], onUpdate: NoAction, map: "fk_sync_negocio")

  @@unique([dispositivo_id, secuencia_local], map: "uq_sync_dispositivo_secuencia")
  @@index([dispositivo_id, estado], map: "idx_sync_dispositivo_estado")
  @@index([negocio_id, estado], map: "idx_sync_negocio_estado")
  @@index([referencia_id], map: "idx_sync_referencia")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model producto {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId    String         @map("negocio_id") @db.Uuid
  categoriaId  String         @map("categoria_id") @db.Uuid
  codigo       String         @db.VarChar(100)
  codigoBarras String?        @map("codigo_barras") @db.VarChar(100)
  nombre       String         @db.VarChar(150)
  descripcion  String?
  unidadMedida unidad_medida  @default(UNIDAD) @map("unidad_medida")
  precioCompra Decimal        @default(0) @map("precio_compra") @db.Decimal(14, 2)
  precioVenta  Decimal        @default(0) @map("precio_venta") @db.Decimal(14, 2)
  stockActual  Decimal        @default(0) @map("stock_actual") @db.Decimal(14, 3)
  stockMinimo  Decimal        @default(0) @map("stock_minimo") @db.Decimal(14, 3)
  stockMaximo  Decimal?       @map("stock_maximo") @db.Decimal(14, 3)
  estado       estado_general @default(ACTIVO)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamp(6)

  detalleAjuste  detalle_ajuste[]
  detalleEntrada detalle_entrada[]
  detalleSalida  detalle_salida[]
  detalleVenta   detalle_venta[]
  movimientos    movimiento_inventario[]

  categoria categoria @relation(fields: [categoriaId], references: [id], onUpdate: NoAction, map: "fk_producto_categoria")
  negocio   negocio   @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_producto_negocio")

  @@unique([negocioId, codigo], map: "uq_producto_negocio_codigo")
  @@index([categoriaId], map: "idx_producto_categoria")
  @@index([codigoBarras], map: "idx_producto_codigo_barras")
  @@index([negocioId], map: "idx_producto_negocio")
  @@map("producto")
}

model proveedor {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId      String         @map("negocio_id") @db.Uuid
  nombre         String         @db.VarChar(150)
  telefono       String?        @db.VarChar(50)
  direccion      String?        @db.VarChar(255)
  email          String?        @db.VarChar(150)
  identificacion String?        @db.VarChar(100)
  observaciones  String?
  estado         estado_general @default(ACTIVO)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamp(6)

  entradas entrada_inventario[]
  negocio  negocio              @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_proveedor_negocio")

  @@index([negocioId], map: "idx_proveedor_negocio")
  @@map("proveedor")
}

model salida_inventario {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId     String           @map("negocio_id") @db.Uuid
  usuarioId     String           @map("usuario_id") @db.Uuid
  dispositivoId String           @map("dispositivo_id") @db.Uuid
  numero        BigInt
  motivo        motivo_salida
  observaciones String?
  estado        estado_documento @default(COMPLETADA)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime         @default(now()) @map("updated_at") @db.Timestamp(6)
  detalles      detalle_salida[]
  dispositivo   dispositivo      @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction, map: "fk_salida_dispositivo")
  negocio       negocio          @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_salida_negocio")
  usuario       usuario          @relation(fields: [usuarioId], references: [id], onUpdate: NoAction, map: "fk_salida_usuario")

  @@unique([negocioId, numero], map: "uq_salida_negocio_numero")
  @@index([createdAt], map: "idx_salida_fecha")
  @@index([negocioId], map: "idx_salida_negocio")
  @@map("salida_inventario")
}

model usuario {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId      String                  @map("negocio_id") @db.Uuid
  nombre         String                  @db.VarChar(150)
  username       String                  @db.VarChar(100)
  passwordHash   String                  @map("password_hash") @db.VarChar(255)
  rol            rol_usuario             @default(ADMINISTRADOR)
  estado         estado_general          @default(ACTIVO)
  ultimoAccesoAt DateTime?               @map("ultimo_acceso_at") @db.Timestamp(6)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime                @default(now()) @map("updated_at") @db.Timestamp(6)
  ajustes        ajuste_inventario[]
  entradas       entrada_inventario[]
  movimientos    movimiento_inventario[]
  salidas        salida_inventario[]
  negocio        negocio                 @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_usuario_negocio")
  ventas         venta[]

  @@unique([negocioId, username], map: "uq_usuario_negocio_username")
  @@index([negocioId], map: "idx_usuario_negocio")
  @@map("usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info. 

model venta {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negocioId     String @map("negocio_id") @db.Uuid
  usuarioId     String @map("usuario_id") @db.Uuid
  dispositivoId String @map("dispositivo_id") @db.Uuid

  numero     BigInt
  subtotal   Decimal          @default(0) @db.Decimal(14, 2)
  descuento  Decimal          @default(0) @db.Decimal(14, 2)
  impuesto   Decimal          @default(0) @db.Decimal(14, 2)
  total      Decimal          @default(0) @db.Decimal(14, 2)
  metodoPago metodo_pago      @default(EFECTIVO)
  estado     estado_documento @default(COMPLETADA)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  detalleVenta detalle_venta[]

  dispositivo dispositivo @relation(fields: [dispositivoId], references: [id], onUpdate: NoAction, map: "fk_venta_dispositivo")
  negocio     negocio     @relation(fields: [negocioId], references: [id], onUpdate: NoAction, map: "fk_venta_negocio")
  usuario     usuario     @relation(fields: [usuarioId], references: [id], onUpdate: NoAction, map: "fk_venta_usuario")

  @@unique([negocioId, numero], map: "uq_venta_negocio_numero")
  @@index([createdAt], map: "idx_venta_fecha")
  @@index([negocioId], map: "idx_venta_negocio")
  @@index([usuarioId], map: "idx_venta_usuario")
  @@map("venta")
}

enum estado_dispositivo {
  ACTIVO
  BLOQUEADO
}

enum estado_documento {
  COMPLETADA
  ANULADA
}

enum estado_general {
  ACTIVO
  INACTIVO
}

enum estado_sincronizacion {
  PENDIENTE
  SINCRONIZANDO
  SINCRONIZADA
  ERROR
}

enum metodo_pago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

enum motivo_ajuste {
  DIFERENCIA_CONTEO
  ERROR_REGISTRO
  CORRECCION
  OTRO
}

enum motivo_salida {
  PRODUCTO_DANADO
  PRODUCTO_VENCIDO
  CONSUMO_INTERNO
  PERDIDA
  ROBO
  MUESTRA
  OTRO
}

enum rol_usuario {
  ADMINISTRADOR
}

enum tipo_ajuste {
  POSITIVO
  NEGATIVO
}

enum tipo_dispositivo {
  DESKTOP
  LAPTOP
  TABLET
}

enum tipo_movimiento {
  INVENTARIO_INICIAL
  ENTRADA
  VENTA
  SALIDA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

enum tipo_referencia_movimiento {
  VENTA
  ENTRADA
  SALIDA
  AJUSTE
}

enum unidad_medida {
  UNIDAD
  KILOGRAMO
  GRAMO
  LIBRA
  LITRO
  MILILITRO
  METRO
  CENTIMETRO
  CAJA
  PAQUETE
  DOCENA
}
